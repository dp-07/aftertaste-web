{
  "extends": ["html-validate:recommended"],
  "rules": {
    "doctype-style": "off",
    "void-style": "off",
    "no-trailing-whitespace": "off",
    "attribute-boolean-style": "off",
    "attribute-empty-style": "off",
    "no-inline-style": "error",
    "require-sri": "off",
    "long-title": [
      "error",
      {
        "maxlength": 70
      }
    ],
    "valid-id": [
      "error",
      {
        "relaxed": true
      }
    ]
  }
}
