# Cloudflare Pages headers. The script-src hash is the inline theme script
# (src/scripts/theme.js); `npm run check:csp` fails if it drifts.
# Cloudflare Web Analytics is off; see README "Analytics (optional)" before
# enabling it, because it needs script-src and connect-src additions.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-3FlxQ0fi2LpEsHcQ/RUU22vgN1Pv/qC0OFDqyTYUHRU=' 'sha256-GfNKvx7SA4914BvIDq0aaBOTte+GUdQ6GxywGN8iDi0=' 'sha256-yOhcEokt/Z+S9MB/RcXNsIpsRp1/GXjQCFzYomWztnQ='; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY

# /patron is the only page with third-party content, and only after a tap: Bondin's
# embed script (script-src) and the Bondin and Buy Me a Coffee checkout iframes
# (frame-src). `!` detaches the site-wide policy first, because Cloudflare would
# otherwise send both and the browser applies the stricter intersection. style-src
# stays 'self' (the widgets style through the CSSOM). `npm run check:csp` checks this.
/patron
  ! Content-Security-Policy
  ! Permissions-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-3FlxQ0fi2LpEsHcQ/RUU22vgN1Pv/qC0OFDqyTYUHRU=' 'sha256-GfNKvx7SA4914BvIDq0aaBOTte+GUdQ6GxywGN8iDi0=' 'sha256-yOhcEokt/Z+S9MB/RcXNsIpsRp1/GXjQCFzYomWztnQ=' https://bondin.io; frame-src https://buymeacoffee.com https://bondin.io; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://bondin.io" "https://buymeacoffee.com"), usb=(), browsing-topics=()

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=86400

/fonts/*
  Cache-Control: public, max-age=86400

/icons/*
  Cache-Control: public, max-age=86400
