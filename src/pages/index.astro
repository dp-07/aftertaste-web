---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/landing/Hero.astro';
import Steps from '../components/landing/Steps.astro';
import Teasers from '../components/landing/Teasers.astro';
import PrivacyLine from '../components/landing/PrivacyLine.astro';
import JoinBeta from '../components/landing/JoinBeta.astro';
import { site } from '../config/site';

const logo = new URL('/icons/icon-512.png', site.url).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: site.url,
    logo,
    email: site.contactEmail,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: site.name,
    description: site.description,
    url: site.url,
    image: logo,
    operatingSystem: 'Android, iOS',
    applicationCategory: 'LifestyleApplication',
    isAccessibleForFree: true,
    inLanguage: 'en-IN',
    author: { '@type': 'Organization', name: site.name },
  },
];
---

<BaseLayout description={site.description} og="home" jsonLd={jsonLd} coffeeLink>
  <Hero />
  <Steps />
  <Teasers />
  <PrivacyLine />
  <JoinBeta />
</BaseLayout>

<script>
  import '../scripts/landing';
  import '../scripts/seal';
  import '../scripts/moved-anchors';
</script>
