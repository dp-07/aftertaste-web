---
/**
 * Keep Aftertaste brewing: three equal option cards (UPI, Bondin, Buy Me a Coffee).
 * Not in the nav and never linked from /privacy, /terms or /support (see RULES, "Payments").
 *
 * - The UPI link has no payee name and no amount, so the UPI app shows the
 *   bank-verified name and its own enter-amount screen.
 * - The QR is generated at build time (qrcode-generator, a devDependency) as
 *   inline SVG: no JS ships, nothing third-party, and no name can be embedded.
 * - Phone or desktop is decided with CSS (pointer, width); both show if unsure.
 * - The UPI ID is never shown: "Copy UPI ID" copies it from a data attribute.
 * - Bondin is a plain link. Its embed script (bondin.io/embed/v1.js) is deliberately not
 *   loaded: CSP is default-src 'none' and the site makes no third-party requests.
 * - A THANK YOU stamp presses after any option is tapped (hidden without JS).
 * - Route /patron (renamed from /coffee on 2026-11-28; /coffee 301s here).
 * - The one inline script (src/scripts/patron.js) is hashed in the CSP.
 *   Without JS the copy button and the stamp stay hidden; all three links and the QR still work.
 */
import qrcode from 'qrcode-generator';
import BaseLayout from '../layouts/BaseLayout.astro';
import SealMark from '../components/brand/SealMark.astro';
import Button from '../components/ui/Button.astro';
import Stamp from '../components/brand/Stamp.astro';
import patronScript from '../scripts/patron.js?raw';
import { site, upiUrl } from '../config/site';

const qr = qrcode(0, 'M');
qr.addData(upiUrl());
qr.make();
const count = qr.getModuleCount();
const QUIET = 4;
let d = '';
for (let r = 0; r < count; r++) {
  for (let c = 0; c < count; c++) {
    if (!qr.isDark(r, c)) continue;
    let end = c;
    while (end + 1 < count && qr.isDark(r, end + 1)) end++;
    d += `M${c + QUIET} ${r + QUIET}h${end - c + 1}v1h-${end - c + 1}z`;
    c = end;
  }
}
const size = count + QUIET * 2;
---

<BaseLayout
  title="Keep Aftertaste brewing"
  description="Aftertaste is free and has no ads. If you enjoy it, support it with UPI, Bondin or Buy Me a Coffee."
>
  <div class="wrap patron">
    <header class="head">
      <SealMark />
      <p class="t-label kicker">Support Aftertaste</p>
      <h1 class="t-display">Keep Aftertaste brewing</h1>
      <p class="t-lede muted">
        Aftertaste is free, with no ads and never will be. Support is optional and unlocks nothing.
      </p>
    </header>

    <ul class="options">
      <li class="card">
        <h2 id="upi-title" class="t-title">
          UPI
        </h2>
        <p class="best muted">Best in India, no fees.</p>
        <div class="card-body">
          <div class="upi-app">
            <Button href={upiUrl()} icon="smartphone" data-support>
              Open UPI app
            </Button>
          </div>
          <div class="upi-qr">
            <svg
              class="qr"
              viewBox={`0 0 ${size} ${size}`}
              width="176"
              height="176"
              role="img"
              aria-label="UPI QR code for Aftertaste"
              shape-rendering="crispEdges"
            >
              <rect class="qr-bg" width={size} height={size}></rect>
              <path class="qr-fg" d={d}></path>
            </svg>
            <p class="t-body-sm muted">Scan with any UPI app.</p>
          </div>
          <div class="copy-id">
            <span class="copy-wrap" data-copy-wrap>
              <Button variant="secondary" icon="copy" data-copy-upi data-upi-id={site.upiId}>
                Copy UPI ID
              </Button>
            </span>
            <p class="status t-body-sm" role="status" aria-live="polite" data-copy-status></p>
          </div>
        </div>
      </li>

      <li class="card">
        <h2 id="bondin-title" class="t-title">
          Bondin
        </h2>
        <p class="best muted">Support on Bondin.</p>
        <div class="card-body">
          <Button href={site.bondinUrl} icon="external-link" target="_blank" rel="noopener" data-support>
            Support with Bondin<span class="visually-hidden"> (opens in a new tab)</span>
          </Button>
        </div>
      </li>

      <li class="card">
        <h2 id="bmc-title" class="t-title">
          Buy Me a Coffee
        </h2>
        <p class="best muted">Cards and international.</p>
        <div class="card-body">
          <Button href={site.buyMeACoffeeUrl} icon="coffee" target="_blank" rel="noopener" data-support>
            Support with Buy Me a Coffee<span class="visually-hidden"> (opens Buy Me a Coffee in a new tab)</span>
          </Button>
        </div>
      </li>
    </ul>

    <div class="thanks" data-thanks hidden>
      <Stamp variant="thanks" size="lg" press="manual" />
    </div>

    <p class="foot t-body-sm muted">
      Payments are handled by Bondin, Buy Me a Coffee or your own UPI app, which shows the bank-verified name you are
      paying. Aftertaste never sees your payment details.
    </p>
  </div>

  <script is:inline set:html={patronScript} />
</BaseLayout>

<style>
  .patron {
    display: grid;
    gap: var(--space-block);
    max-inline-size: 64rem;
    margin-inline: auto;
    padding-block-start: clamp(2rem, 1rem + 4vw, 4.5rem);
  }

  .head {
    display: grid;
    justify-items: start;
    gap: var(--s-16);
    max-inline-size: 44rem;
  }

  .head :global(.seal) {
    inline-size: 88px;
    block-size: 88px;
  }

  .kicker {
    color: var(--primary-ink);
  }

  /* Three cards of the same size and style: one column, then three from 60rem. */
  .options {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-16);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 60rem) {
    .options {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-24);
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: var(--s-24);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--elevation);
  }

  .card h2 {
    margin: 0;
  }

  .best {
    margin: 0;
  }

  .card-body {
    display: grid;
    justify-items: start;
    align-content: start;
    gap: var(--s-16);
    margin-block-start: var(--s-16);
  }

  .card-body :global(.btn) {
    max-inline-size: 100%;
  }

  .upi-qr {
    display: grid;
    justify-items: start;
    gap: var(--s-8);
  }

  /* A fixed light card with dark modules in both themes, so it always scans. */
  .qr {
    inline-size: 176px;
    block-size: 176px;
    border-radius: var(--r-md);
    box-shadow: var(--elevation);
  }

  .qr-bg {
    fill: #fff;
  }

  .qr-fg {
    fill: #16130f;
  }

  /* Mouse and keyboard devices cannot open a UPI app: QR only. */
  @media (hover: hover) and (pointer: fine) {
    .upi-app {
      display: none;
    }
  }

  /* Phones: the UPI app button replaces the QR. Tablets and desktops get the QR. */
  @media (pointer: coarse) and (width < 48rem) {
    .upi-qr {
      display: none;
    }
  }

  .copy-id {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-8) var(--s-16);
  }

  .copy-wrap:not(.ready) {
    display: none;
  }

  .status {
    margin: 0;
    color: var(--primary-ink);
  }

  .thanks {
    display: flex;
    justify-content: center;
    padding-block: var(--s-8);
  }

  .thanks[hidden] {
    display: none;
  }

  .foot {
    max-inline-size: 44rem;
    margin: 0;
    padding-block-start: var(--s-20);
    border-block-start: 1px solid var(--line);
  }
</style>
