---
/**
 * Every page: head (SEO, social cards, icons, theme), skip link, beta banner, header,
 * <main id="main">, footer. The only inline script is the theme script; its
 * SHA-256 is in public/_headers (CSP) and `npm run check:csp` verifies it.
 */
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/brand.css';
import prataUrl from '../assets/fonts/prata-400.woff2?url';
import dmSansUrl from '../assets/fonts/dm-sans-400.woff2?url';
import themeScript from '../scripts/theme.js?raw';
import BetaBanner from '../components/BetaBanner.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../config/site';

export type OgKind = 'home' | 'legal' | 'support' | 'default';

interface Props {
  /** Page title without the site name (omit on the home page). */
  title?: string;
  description: string;
  og?: OgKind;
  noindex?: boolean;
  /** Structured data objects, serialised as JSON-LD. */
  jsonLd?: object[];
}

const { title, description, og = 'default', noindex = false, jsonLd = [] } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name}: ${site.tagline.toLowerCase()}`;
const pathname = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/');
const canonical = new URL(pathname === '/' ? '/' : pathname.replace(/\/$/, ''), site.url).href;
const ogImage = new URL(`/og/${og}.png`, site.url).href;
const ogAlt = `${site.name}: ${site.tagline}`;
---

<!doctype html>
<html lang="en-IN" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <script is:inline set:html={themeScript} />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="preload" href={prataUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={dmSansUrl} as="font" type="font/woff2" crossorigin />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      data-scheme="light"
      content={site.themeColor.light}
      media="(prefers-color-scheme: light)"
    />
    <meta name="theme-color" data-scheme="dark" content={site.themeColor.dark} media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/mask-icon.svg" color="#C2412D" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {jsonLd.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <BetaBanner />
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
