---
/**
 * "The receipt": the visit receipt feeds out of a printer slot as you scroll,
 * in the brand's receiptPrint steps (−1, −0.74, −0.46, −0.16, 0 of its height),
 * then the LOGGED stamp lands.
 *
 * - Scroll-driven (CSS animation-timeline, wide and tall viewports): the
 *   section is tall and its content sticky; scrolling feeds the paper.
 * - Otherwise, with JS: src/scripts/landing.ts sets data-mode="time" and adds
 *   .is-printing once the printer is in view; the same steps play over time
 *   (360 ms move, 200 ms pause).
 * - Reduced motion or no JS: the receipt is simply there, stamped.
 */
import Receipt from '../brand/Receipt.astro';
---

<section id="receipt" class="receipt-feature" aria-labelledby="receipt-title">
  <div class="sticky">
    <div class="wrap">
      <p class="running-head t-label">
        <span class="num">06</span> The receipt
      </p>
      <div class="grid-12 body">
        <div class="copy">
          <h2 id="receipt-title" class="t-display">
            Every visit, on paper.
          </h2>
          <p class="lead">Turn any visit into a receipt and share it as an image.</p>
          <p>
            Dishes and ratings, the total, the overall verdict and a LOGGED stamp. Send it to the friend who asked where
            you ate last night.
          </p>
        </div>
        <div class="printer" data-printer>
          <div class="slot" aria-hidden="true"></div>
          <div class="feed">
            <Receipt
              placeName="Hill Road Momos"
              area="Dehradun"
              date="12 Nov 2026"
              dishes={[
                { name: 'Jhol momo', rating: 5 },
                { name: 'Thukpa', rating: 4 },
                { name: 'Ginger lemon tea', rating: 4 },
              ]}
              notes="Ask for the spicy chutney."
              total="₹480"
              overall={5}
              class="printed"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .receipt-feature {
    padding-block-start: var(--space-section);
  }

  .body {
    row-gap: var(--space-block);
    margin-block-start: var(--space-block);
    align-items: center;
  }

  .copy {
    display: grid;
    gap: var(--s-20);
    max-inline-size: var(--measure);
  }

  .copy p {
    color: var(--muted);
  }

  .copy .lead {
    color: var(--text);
    font-size: var(--fs-lede);
    line-height: 1.45;
  }

  .printer {
    display: grid;
    justify-items: center;
    inline-size: min(100%, 400px);
    justify-self: center;
  }

  .slot {
    position: relative;
    z-index: 1;
    inline-size: 100%;
    block-size: 18px;
    border-radius: var(--r-pill);
    background: light-dark(#1f1b16, #0d0b09);
    box-shadow:
      inset 0 -5px 0 light-dark(#3a332b, #29241e),
      0 0 0 1px light-dark(transparent, #4d453b);
  }

  .feed {
    display: grid;
    justify-items: center;
    inline-size: 100%;
    margin-block-start: -9px;
    padding: 0 24px 40px;
    overflow: hidden;
  }

  @media (width >= 64rem) {
    .copy {
      grid-column: 1 / span 5;
    }
    .printer {
      grid-column: 7 / -1;
    }
  }

  /* ── Scroll-driven printing ─────────────────────────────────────── */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (width >= 48rem) and (height >= 46rem) {
      .receipt-feature {
        block-size: 260vh;
        view-timeline: --print block;
      }

      .sticky {
        position: sticky;
        inset-block-start: 0;
        display: grid;
        align-content: center;
        min-block-size: 100vh;
        padding-block: var(--s-24);
      }

      /* Longhands on purpose: the CSS minifier folds animation-timeline into
         the animation shorthand, which browsers reject. */
      .feed :global(.printed) {
        animation-name: feed-steps;
        animation-fill-mode: both;
        animation-timing-function: linear;
        animation-timeline: --print;
        animation-range: contain 4% contain 72%;
      }

      .feed :global(.rc-stamp) {
        animation-name: logged-land;
        animation-fill-mode: both;
        animation-timing-function: linear;
        animation-timeline: --print;
        animation-range: contain 76% contain 90%;
      }
    }
  }

  /* ── Time-based printing (no scroll timelines, or small screens) ── */
  @media (prefers-reduced-motion: no-preference) {
    .printer[data-mode='time']:not(.is-printing) .feed :global(.printed) {
      transform: translateY(-100%);
    }

    .printer[data-mode='time']:not(.is-printing) .feed :global(.rc-stamp) {
      opacity: 0;
    }

    .printer[data-mode='time'].is-printing .feed :global(.printed) {
      animation: feed-steps 2240ms linear both;
    }

    .printer[data-mode='time'].is-printing .feed :global(.rc-stamp) {
      animation: logged-land 700ms linear 2300ms both;
    }
  }

  /* Four feeds of 360 ms with 200 ms pauses, as fractions of the receipt height. */
  @keyframes feed-steps {
    0% {
      transform: translateY(-100%);
      animation-timing-function: var(--ease-standard);
    }
    16% {
      transform: translateY(-74%);
    }
    25% {
      transform: translateY(-74%);
      animation-timing-function: var(--ease-standard);
    }
    41% {
      transform: translateY(-46%);
    }
    50% {
      transform: translateY(-46%);
      animation-timing-function: var(--ease-standard);
    }
    66% {
      transform: translateY(-16%);
    }
    75% {
      transform: translateY(-16%);
      animation-timing-function: var(--ease-standard);
    }
    91%,
    100% {
      transform: none;
    }
  }

  /* brand stampPress, at the receipt stamp's −12° and 0.88 opacity. */
  @keyframes logged-land {
    0% {
      opacity: 0;
      transform: rotate(-6deg) scale(1.7);
      animation-timing-function: var(--ease-standard);
    }
    60% {
      opacity: 0.88;
      transform: rotate(-12deg) scale(0.94);
      animation-timing-function: var(--ease-out);
    }
    100% {
      opacity: 0.88;
      transform: rotate(-12deg) scale(1);
    }
  }
</style>
