---
/**
 * "Your taste report": the app's optional AI taste report (privacy policy
 * section 8), described in plain words from the policy's own facts, beside a
 * sample report with obviously made-up numbers.
 *
 * The bars are one series in one hue (paprika), every value is written next
 * to its bar in text colours, so there is no legend and no colour-only
 * meaning. Bars are SVG rects with percentage widths: the CSP forbids style
 * attributes, and attributes are not styles.
 */
import InkLink from '../ui/InkLink.astro';

// Sample data: not from anyone's diary.
const cuisines = [
  { name: 'Momos and Tibetan', share: 34 },
  { name: 'North Indian', share: 27 },
  { name: 'Bakes and sweets', share: 18 },
];
const favourite = { place: 'Hill Road Momos', visits: 7 };
---

<section id="taste-report" class="taste defer-render" aria-labelledby="taste-title">
  <div class="wrap">
    <p class="running-head t-label">
      <span class="num">12</span> Your taste report
    </p>
    <div class="grid-12 body">
      <div class="copy">
        <h2 id="taste-title" class="t-display">
          Your taste report
        </h2>
        <p class="lead">A monthly look at how you eat. Off until you turn it on.</p>
        <p>
          Your go-to dishes, your rhythm, your best-value bite. Our own code works out every number from your diary. An
          AI model only writes the short lines of text around those numbers.
        </p>
        <dl class="facts">
          <div>
            <dt class="t-label">Sent to the AI</dt>
            <dd>
              The names of your dishes, so each can be labelled with a cuisine, a dish type and flavours, plus
              statistics we calculate from your diary. Your places show up in those only as placeholders like “place 1”.
            </dd>
          </div>
          <div>
            <dt class="t-label">Never sent</dt>
            <dd>
              Your notes, photos, place names, addresses, cities, map positions, your device’s location, visit dates,
              your name, email address or account ID, and anything about other people.
            </dd>
          </div>
          <div>
            <dt class="t-label">Who gets it</dt>
            <dd>
              Anthropic, through its Claude API, as our service provider. By default it doesn’t use that data to train
              its models. It keeps it for a limited time under its API data retention policy, and longer only where
              needed to enforce its usage policy or required by law.
            </dd>
          </div>
          <div>
            <dt class="t-label">What we keep</dt>
            <dd>
              Your latest report, until a newer one replaces it, you turn the feature off or you delete your account.
              Turn it off in Profile and your current report and dish labels are deleted straight away.
            </dd>
          </div>
        </dl>
        <p class="source">
          <InkLink href="/privacy#ai-taste-report">Privacy policy, section 8</InkLink>
        </p>
      </div>

      <figure class="report" aria-labelledby="report-caption">
        <figcaption id="report-caption" class="report-head">
          <span class="t-label kicker">Taste report · sample data</span>
          <span class="t-title">Your taste, so far</span>
        </figcaption>

        <div class="block">
          <h3 class="t-label muted">Top cuisines, by share of dishes logged</h3>
          <ol class="cuisines">
            {cuisines.map((c) => (
              <li>
                <span class="c-name">{c.name}</span>
                <span class="t-mono c-value">{c.share}%</span>
                <svg class="bar" width="100%" height="8" aria-hidden="true" focusable="false">
                  <rect class="track" width="100%" height="8" rx="4" />
                  <rect class="fill" width={`${c.share}%`} height="8" rx="4" />
                </svg>
              </li>
            ))}
          </ol>
        </div>

        <dl class="stats">
          <div class="stat">
            <dt class="t-label muted">Most returned to</dt>
            <dd>
              <span class="place">{favourite.place}</span> <span class="t-mono muted">{favourite.visits} visits</span>
            </dd>
          </div>
        </dl>

        <p class="t-body-sm fine">Made-up numbers to show the idea. Not a real diary.</p>
      </figure>
    </div>
  </div>
</section>

<style>
  .taste {
    padding-block-start: var(--space-section);
  }

  .body {
    row-gap: var(--space-block);
    margin-block-start: var(--space-block);
    align-items: center;
  }

  .copy {
    display: grid;
    gap: var(--s-20);
    max-inline-size: var(--measure);
  }

  .facts {
    display: grid;
    gap: var(--s-16);
    margin: 0;
    padding-block-start: var(--s-8);
  }

  .facts > div {
    display: grid;
    gap: var(--s-4);
    padding-block-start: var(--s-12);
    border-block-start: 1px solid var(--line);
  }

  .facts dt {
    color: var(--primary-ink);
  }

  .facts dd {
    margin: 0;
    color: var(--muted);
  }

  .source {
    font-size: var(--fs-body-sm);
  }

  .copy p {
    color: var(--muted);
  }

  .copy .lead {
    color: var(--text);
    font-size: var(--fs-lede);
    line-height: 1.45;
  }

  .report {
    position: relative;
    display: grid;
    gap: var(--s-24);
    max-inline-size: 30rem;
    margin: 0;
    padding: clamp(1.25rem, 0.9rem + 1.6vw, 2rem);
    border: 1px dashed var(--line-strong);
    border-radius: var(--r-lg);
    background: var(--surface);
  }

  .report-head {
    display: grid;
    gap: var(--s-8);
  }

  .kicker {
    color: var(--primary-ink);
  }

  .block {
    display: grid;
    gap: var(--s-12);
  }

  .cuisines {
    display: grid;
    gap: var(--s-16);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cuisines li {
    display: grid;
    grid-template-columns: 1fr auto;
    row-gap: 6px;
  }

  .c-value {
    color: var(--text);
  }

  .bar {
    grid-column: 1 / -1;
    block-size: 8px;
  }

  .track {
    fill: var(--line);
  }

  .fill {
    fill: var(--primary);
  }

  .stats {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-24);
    margin: 0;
    padding-block-start: var(--s-20);
    border-block-start: 1px solid var(--line);
  }

  .stat {
    display: grid;
    align-content: start;
    gap: var(--s-8);
  }

  dd {
    margin: 0;
  }

  .figure {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    line-height: 1;
    color: var(--primary-ink);
  }

  .place {
    display: block;
    font-family: var(--font-display);
    font-size: var(--fs-card-title);
    line-height: var(--lh-card-title);
  }

  .fine {
    color: var(--muted);
  }

  @media (width >= 64rem) {
    .copy {
      grid-column: 1 / span 5;
    }
    .report {
      grid-column: 7 / -1;
    }
  }
</style>
