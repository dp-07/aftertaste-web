---
/**
 * Home hero (web revamp 2026-11-27): status line, the wordmark and the tagline
 * as the page's one h1, one line on what the app is, the call to action, and
 * the sealed mushroom whose lid opens onto the feature pages.
 */
import { site } from '../../config/site';
import Wordmark from '../brand/Wordmark.astro';
import Button from '../ui/Button.astro';
import StoreBadge from '../ui/StoreBadge.astro';
import HeroSeal from './HeroSeal.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap grid-12 hero-grid">
    <div class="intro">
      <p class="t-label kicker">
        <span class="seg">Private beta ·</span>{' '}
        <span class="seg">
          Android and <span class="ios">iOS</span> ·
        </span>{' '}
        <span class="seg">still cooking</span>
      </p>
      <h1 id="hero-title">
        <Wordmark variant="stacked" animate class="hero-mark" />
        <span class="visually-hidden"> — </span>
        <span class="tagline">{site.tagline}</span>
      </h1>
      <p class="support">A private food diary. Log the place, rate the dish, know what to order next time.</p>
      <div class="actions">
        <StoreBadge store="play" />
        <StoreBadge store="appStore" />
        <Button href="#join" icon="arrow-down" iconEnd={true}>
          Join the beta
        </Button>
        <Button href="#how-it-works" variant="ghost">
          How it works
        </Button>
      </div>
    </div>
    <div class="visual">
      <HeroSeal />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2rem, 1rem + 4vw, 5rem) clamp(1rem, 0.5rem + 2vw, 2rem);
  }

  .hero-grid {
    row-gap: var(--s-32);
    align-items: center;
  }

  .intro {
    display: grid;
    justify-items: start;
    gap: var(--s-24);
  }

  .kicker {
    margin: 0;
    color: var(--primary-ink);
  }

  /* The label role is upper case; the platform's name keeps its own case. */
  .ios {
    text-transform: none;
  }

  /* The eyebrow must not rewrap when DM Sans 500 replaces its fallback (not
     preloaded), or the hero shifts. On narrow screens "still cooking" always
     takes the second line. */
  .seg {
    white-space: nowrap;
  }

  @media (width < 40rem) {
    .seg:last-child {
      display: block;
    }
  }

  h1 {
    display: grid;
    gap: clamp(1rem, 0.6rem + 1.6vw, 2rem);
    margin: 0;
  }

  .hero :global(.hero-mark) {
    font-size: var(--fs-wordmark);
    margin-inline-start: -0.04em;
  }

  .tagline {
    font-size: var(--fs-title);
    line-height: var(--lh-title);
    color: var(--text);
  }

  @media (prefers-reduced-motion: no-preference) {
    .tagline {
      animation: settle var(--dur-slow) var(--ease-enter) 1150ms both;
    }
  }

  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(var(--enter-y));
    }
  }

  .support {
    max-inline-size: 26rem;
    margin: 0;
    color: var(--muted);
    font-size: var(--fs-lede);
    line-height: 1.45;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-12);
  }

  @media (width >= 64rem) {
    .intro {
      grid-column: 1 / span 7;
    }
    .visual {
      grid-column: 8 / -1;
    }
  }
</style>
