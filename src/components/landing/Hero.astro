---
import heroShot from '../../assets/screenshots/home-placeholder.png';
import { site } from '../../config/site';
import PhoneFrame from '../brand/PhoneFrame.astro';
import SealMark from '../brand/SealMark.astro';
import Wordmark from '../brand/Wordmark.astro';
import Button from '../ui/Button.astro';
import StoreBadge from '../ui/StoreBadge.astro';
// TODO(screenshots): home-placeholder.png is a rendered placeholder; replace it with a real Home screenshot (README "Screenshots").
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap grid-12 hero-grid">
    <div class="intro">
      <p class="t-label kicker">
        <span class="seg">Private beta ·</span>{' '}
        <span class="seg">
          Android and <span class="ios">iOS</span> ·
        </span>{' '}
        <span class="seg">still cooking</span>
      </p>
      <h1 id="hero-title">
        <Wordmark variant="stacked" animate class="hero-mark" />
        <span class="visually-hidden"> — </span>
        <span class="tagline">{site.tagline}</span>
      </h1>
      <p class="support">
        A food diary for Android and iOS. Log the places you eat at and every dish you order, with a photo and a rating.
        Months later, you'll know exactly what to order, and what to skip.
      </p>
      <div class="actions">
        <StoreBadge store="play" />
        <StoreBadge store="appStore" />
        <Button href="#join" icon="arrow-down" iconEnd={true}>
          Join the beta
        </Button>
        <Button href="#how-it-works" variant="secondary">
          See how it works
        </Button>
      </div>
      <p class="t-body-sm fine">Free. Private by default. No ads, no tracking.</p>
    </div>
    <div class="device">
      <PhoneFrame
        src={heroShot}
        alt="The Aftertaste home screen: What should we eat?, a Pick for me button and a Want to try list."
        priority
      >
        <SealMark class="seal-stamp" />
      </PhoneFrame>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2rem, 1rem + 4vw, 5rem) 0;
  }

  .hero-grid {
    row-gap: var(--space-block);
    align-items: center;
  }

  .intro {
    display: grid;
    justify-items: start;
    gap: var(--s-24);
  }

  .kicker {
    color: var(--primary-ink);
  }

  /* The label role is upper case; the platform's name keeps its own case. */
  .ios {
    text-transform: none;
  }

  /* The eyebrow must not rewrap when DM Sans 500 replaces its fallback (not
     preloaded), or the hero shifts. Segments never break inside, and on
     narrow screens "still cooking" always takes the second line: the first
     line fits at 320 px in both fonts (236 and 259 of 280 px). */
  .seg {
    white-space: nowrap;
  }

  @media (width < 40rem) {
    .seg:last-child {
      display: block;
    }
  }

  h1 {
    display: grid;
    gap: clamp(1rem, 0.6rem + 1.6vw, 2rem);
    margin: 0;
  }

  .hero :global(.hero-mark) {
    font-size: var(--fs-wordmark);
    margin-inline-start: -0.04em;
  }

  .tagline {
    font-size: var(--fs-title);
    line-height: var(--lh-title);
    color: var(--text);
  }

  @media (prefers-reduced-motion: no-preference) {
    .tagline {
      animation: settle var(--dur-slow) var(--ease-enter) 1150ms both;
    }
  }

  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(var(--enter-y));
    }
  }

  .support {
    max-inline-size: 30rem;
    color: var(--muted);
    font-size: var(--fs-body);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-12);
  }

  .fine {
    color: var(--muted);
  }

  .device {
    display: grid;
    justify-items: center;
  }

  .device :global(.phone) {
    max-inline-size: min(20rem, 78vw);
  }

  /* The diary seal, pressed onto the page beside the phone (wide layouts only:
     on narrow screens it would sit on the app's own content). */
  .device :global(.seal-stamp) {
    display: none;
  }

  @media (width >= 64rem) {
    .intro {
      grid-column: 1 / span 7;
    }
    .device {
      grid-column: 8 / -1;
      justify-items: end;
    }
    .device :global(.phone) {
      max-inline-size: 21rem;
    }
    .device :global(.seal-stamp) {
      display: block;
      position: absolute;
      inline-size: 7.5rem;
      inset-inline-start: -30%;
      inset-block-end: 6%;
      transform: rotate(-8deg);
      opacity: 0.94;
    }
  }
</style>
