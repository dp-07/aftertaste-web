---
/**
 * A list of places as the app shows them in search and in Add Place's
 * "Near you": a tonal pin tile, Prata name, mono meta, an optional chip.
 * With `query`, a pill search bar (SPEC rule 9) sits on top.
 */
import Icon from '../ui/Icon.astro';

interface Item {
  name: string;
  meta: string;
  chip?: string;
}
interface Props {
  items: Item[];
  query?: string;
  heading?: string;
  label: string;
}
const { items, query, heading, label } = Astro.props;
---

<div class="place-list" role="group" aria-label={label}>
  {query && (
    <p class="search">
      <Icon name="search" size={20} />
      <span>{query}</span>
      <span class="caret" aria-hidden="true" />
    </p>
  )}
  {heading && <p class="t-label muted heading">{heading}</p>}
  <ul>
    {items.map((it) => (
      <li>
        <span class="pin">
          <Icon name="map-pin" size={18} />
        </span>
        <span class="text">
          <span class="t-card-title name">{it.name}</span> <span class="t-mono muted">{it.meta}</span>
        </span>{' '}
        {it.chip && <span class="chip t-label">{it.chip}</span>}
      </li>
    ))}
  </ul>
</div>

<style>
  .place-list {
    display: grid;
    gap: var(--s-12);
    padding: var(--s-16);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--elevation);
  }
  .search {
    display: flex;
    align-items: center;
    gap: var(--s-12);
    min-block-size: var(--control-h);
    padding-inline: var(--s-20);
    border: 1px solid var(--primary);
    border-radius: var(--r-pill);
    background: var(--raised);
    color: var(--muted);
  }
  .search span:first-of-type {
    color: var(--text);
  }
  .caret {
    inline-size: 1.5px;
    block-size: 1.2em;
    margin-inline-start: -10px;
    background: var(--primary);
  }
  @media (prefers-reduced-motion: no-preference) {
    .caret {
      animation: blink 1.1s steps(1) infinite;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .heading {
    padding-inline: var(--s-4);
  }
  ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
    align-items: center;
    gap: var(--s-12);
    padding-block: var(--s-12);
    border-block-start: 1px solid var(--line);
  }
  li:first-child {
    border-block-start: 0;
  }
  .pin {
    display: grid;
    place-items: center;
    inline-size: var(--icon-tile);
    block-size: var(--icon-tile);
    border-radius: 50%;
    background: var(--primary-soft);
    color: var(--primary);
    flex: none;
  }
  .text {
    display: grid;
    flex: 1;
    min-inline-size: 0;
  }
  .name {
    font-size: 1.0625rem;
  }
  .chip {
    padding: 4px 10px;
    border-radius: var(--r-pill);
    background: var(--herb-soft);
    color: var(--herb-ink);
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
</style>
