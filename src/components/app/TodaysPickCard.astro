---
/**
 * The app's Today's pick card (SPEC v1.10): a printed card on page paper with
 * square corners and a double rule (1.5 px line-strong, 3 px gap, 1 px line),
 * the photo carousel (a glyph stands in, dots on a scrim pill), the TODAY'S PICK
 * stamp, then name, mono meta, rating and one reason line over the paper
 * pattern, and the three actions. A static replica: the actions are drawn, not
 * buttons, and are hidden from assistive tech.
 */
import Stamp from '../brand/Stamp.astro';
import PaperPattern from '../brand/PaperPattern.astro';
import Icon from '../ui/Icon.astro';
import Rating from '../ui/Rating.astro';
import Thumb from './Thumb.astro';

interface Props {
  name: string;
  meta: string;
  rating: number;
  reason: string;
  kind: 'mushroom' | 'sprout' | 'noodle' | 'cinnamon';
  /** Number of photos in the carousel (dots); the first is shown. */
  photos?: number;
  label: string;
}
const { name, meta, rating, reason, kind, photos = 4, label } = Astro.props;
---

<figure class="pick" aria-label={label}>
  <div class="inner">
    <div class="photo">
      <Thumb kind={kind} class="pick-photo" />
      <span class="dots" aria-hidden="true">
        {Array.from({ length: photos }, (_, i) => (
          <span class:list={['dot', { on: i === 0 }]} />
        ))}
      </span>
    </div>
    <div class="body">
      <PaperPattern id="pick-pattern" />
      <Stamp variant="todaysPick" press class="pick-stamp" />
      <p class="t-card-title name">{name}</p>
      <p class="t-mono muted meta">
        <span>{meta}</span>
        <Rating value={rating} />
      </p>
      <p class="reason">{reason}</p>
      <div class="actions" aria-hidden="true">
        <span class="act act--primary">
          <Icon name="book-open" size={18} /> Open place
        </span>
        <span class="row">
          <span class="act act--secondary">
            <Icon name="bookmark" size={18} /> Save
          </span>
          <span class="act act--ghost">Not today</span>
        </span>
      </div>
    </div>
  </div>
</figure>

<style>
  .pick {
    max-inline-size: 26rem;
    margin: 0;
    padding: 3px;
    border: 1.5px solid var(--line-strong);
    background: var(--bg);
    box-shadow: var(--elevation);
  }
  .inner {
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .photo {
    position: relative;
  }
  .photo :global(.pick-photo) {
    inline-size: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 0;
  }
  .photo :global(.pick-photo .food) {
    inline-size: 38%;
    block-size: 38%;
  }
  .dots {
    position: absolute;
    inset-block-end: var(--s-8);
    inset-inline-start: 50%;
    display: flex;
    gap: 6px;
    padding: 6px var(--s-8);
    border-radius: var(--r-sm);
    background: var(--scrim);
    transform: translateX(-50%);
  }
  .dot {
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background: var(--on-primary);
    opacity: 0.5;
  }
  .dot.on {
    opacity: 1;
  }
  .body {
    position: relative;
    display: grid;
    gap: var(--s-8);
    padding: var(--s-20);
  }
  .body > :not(.paper-pattern) {
    position: relative;
  }
  .body :global(.pick-stamp) {
    justify-self: start;
    margin-block-end: var(--s-4);
  }
  .name {
    margin: 0;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-12);
    margin: 0;
  }
  .reason {
    margin: 0;
    color: var(--text);
  }
  .actions {
    display: grid;
    gap: var(--s-8);
    margin-block-start: var(--s-12);
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-8);
  }
  .act {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-8);
    min-block-size: var(--control-h);
    border-radius: var(--r-pill);
    font-size: var(--fs-button);
    font-weight: 500;
  }
  .act--primary {
    background: var(--btn-bg);
    color: var(--on-primary);
  }
  .act--secondary {
    border: 1px solid var(--line-strong);
    background: var(--raised);
    color: var(--text);
  }
  .act--ghost {
    color: var(--primary-ink);
  }
</style>
