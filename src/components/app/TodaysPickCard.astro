---
/**
 * The app's Today's pick (SPEC v1.12): a bottom sheet over Home on the raised
 * surface, a grab handle and a close button, then a rounded photo carousel with a
 * TODAY'S PICK pill (top-left), a rating chip (top-right) and a pill page
 * indicator; the place name in Prata, "Category • City" in mono, the reason as a
 * soft primary chip; "Open place" and "Not today" side by side, and an "Another
 * pick" text link.
 *
 * Interactive replica (web revamp 2026-11-27), enhanced by src/scripts/pick.ts:
 * - the photos are a scroll-snap track, so they swipe natively (and scroll with
 *   the arrow keys once focused); the page indicator follows;
 * - "Another pick" cross-fades to the next sample place and announces it.
 * Without JavaScript the first place shows and the button is hidden. Open place
 * and Not today are drawn, not buttons, and hidden from assistive tech.
 * Photos are food glyphs standing in for photos; every place is made up.
 */
import Icon from '../ui/Icon.astro';
import Thumb from './Thumb.astro';

type Kind = 'mushroom' | 'sprout' | 'noodle' | 'cinnamon';
export interface Pick {
  name: string;
  /** "Category • City", as the app prints it. */
  meta: string;
  rating: number | null;
  reason: string;
  photos: Kind[];
}

interface Props {
  picks: Pick[];
  label: string;
}
const { picks, label } = Astro.props;
---

<figure class="sheet" aria-label={label} data-pick-card>
  <div class="top" aria-hidden="true">
    <span class="handle"></span>
    <span class="close">
      <Icon name="x" size={20} />
    </span>
  </div>
  {picks.map((p, n) => (
    <div class="pick" data-pick-panel hidden={n > 0 ? true : undefined}>
      <div class="photo">
        <section
          class="track"
          tabindex={n === 0 ? 0 : -1}
          aria-label={`Photos of ${p.name}, swipe or use the arrow keys`}
          data-track
        >
          {p.photos.map((k, i) => (
            <div class="slide" role="group" aria-roledescription="photo" aria-label={`${i + 1} of ${p.photos.length}`}>
              <Thumb kind={k} class="pick-photo" />
            </div>
          ))}
        </section>
        <span class="pill pill--tag t-label" aria-hidden="true">
          TODAY’S PICK
        </span>
        {p.rating !== null && (
          <span class="pill pill--rating t-mono" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
              <path d="M12 2.6l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.5l-5.9 3.2 1.3-6.6-4.9-4.6 6.6-.8z" />
            </svg>
            {p.rating.toFixed(1)}
          </span>
        )}
        {p.photos.length > 1 && (
          <span class="dots" aria-hidden="true">
            {p.photos.map((_, i) => (
              <span class:list={['dot', { on: i === 0 }]} data-dot />
            ))}
          </span>
        )}
      </div>
      <div class="body">
        <p class="name" data-pick-name>
          {p.name}
          {p.rating !== null && <span class="visually-hidden">, rated {p.rating.toFixed(1)} out of 5</span>}
        </p>
        <p class="t-mono muted meta">{p.meta}</p>
        <p class="chip">{p.reason}</p>
      </div>
    </div>
  ))}
  <div class="actions" aria-hidden="true">
    <span class="act act--primary">
      <Icon name="book-open" size={18} /> Open place
    </span>
    <span class="act act--secondary">
      <Icon name="x" size={18} /> Not today
    </span>
  </div>
  {picks.length > 1 && (
    <button type="button" class="another" data-another>
      Another pick
    </button>
  )}
  <p class="visually-hidden" aria-live="polite" data-pick-status></p>
</figure>

<style>
  .sheet {
    inline-size: min(100%, 26rem);
    margin: 0;
    padding: 0 var(--s-20) var(--s-20);
    border-radius: var(--r-xl);
    background: var(--raised);
    box-shadow: var(--elevation);
  }
  .top {
    position: relative;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    min-block-size: 48px;
    margin-inline-end: calc(var(--s-12) * -1);
  }
  .handle {
    position: absolute;
    inset-block-start: 10px;
    inset-inline-start: 50%;
    inline-size: 40px;
    block-size: 4px;
    border-radius: 2px;
    background: var(--line-strong);
    transform: translateX(-50%);
  }
  .close {
    display: inline-grid;
    place-items: center;
    inline-size: 40px;
    block-size: 40px;
    color: var(--text);
  }
  .pick[hidden] {
    display: none;
  }
  .photo {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-lg);
  }
  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    border-radius: var(--r-lg);
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .track:focus-visible {
    outline: 3px solid var(--primary);
    outline-offset: -3px;
  }
  .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }
  .slide :global(.pick-photo) {
    inline-size: 100%;
    aspect-ratio: 100 / 74;
    border-radius: 0;
  }
  .slide :global(.pick-photo .food) {
    inline-size: 34%;
    block-size: 34%;
  }
  .pill {
    position: absolute;
    inset-block-start: var(--s-12);
    display: inline-flex;
    align-items: center;
    gap: var(--s-4);
    block-size: 28px;
    padding-inline: var(--s-12);
    border-radius: var(--r-pill);
    background: var(--surface);
    pointer-events: none;
  }
  .pill--tag {
    inset-inline-start: var(--s-12);
    color: var(--primary-ink);
    letter-spacing: 0.12em;
  }
  .pill--rating {
    inset-inline-end: var(--s-12);
    padding-inline: var(--s-8);
    color: var(--text);
  }
  .pill--rating svg {
    inline-size: 13px;
    block-size: 13px;
    fill: var(--primary);
  }
  .dots {
    position: absolute;
    inset-block-end: var(--s-8);
    inset-inline-start: 50%;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 7px var(--s-8);
    border-radius: var(--r-pill);
    background: var(--scrim);
    transform: translateX(-50%);
    pointer-events: none;
  }
  .dot {
    inline-size: 6px;
    block-size: 6px;
    border-radius: 3px;
    background: var(--on-primary);
    opacity: 0.55;
    transition:
      inline-size var(--dur-base) var(--ease-out),
      opacity var(--dur-base) var(--ease-out);
  }
  .dot.on {
    inline-size: 18px;
    opacity: 1;
  }
  .body {
    display: grid;
    gap: var(--s-8);
    margin-block-start: var(--s-16);
  }
  .body > p {
    margin: 0;
  }
  .name {
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1.15;
    color: var(--text);
  }
  .chip {
    justify-self: start;
    margin-block-start: var(--s-4);
    padding: var(--s-4) var(--s-12);
    border-radius: var(--r-pill);
    background: var(--primary-soft);
    color: var(--primary-ink);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
    font-weight: 500;
  }
  .actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-8);
    margin-block-start: var(--s-16);
  }
  .act {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-8);
    min-block-size: var(--control-h);
    border-radius: var(--r-pill);
    font-size: var(--fs-button);
    font-weight: 500;
  }
  .act--primary {
    background: var(--btn-bg);
    color: var(--on-primary);
  }
  .act--secondary {
    border: 1px solid var(--line-strong);
    background: var(--raised);
    color: var(--text);
  }
  .another {
    display: flex;
    align-items: center;
    min-block-size: 44px;
    margin: var(--s-8) auto 0;
    padding-inline: var(--s-16);
    border: 0;
    border-radius: var(--r-pill);
    background: none;
    color: var(--primary-ink);
    font: inherit;
    font-size: var(--fs-body-sm);
    font-weight: 500;
    cursor: pointer;
  }
  .another:hover,
  .another:active {
    background: var(--primary-soft);
  }
  .another:focus-visible {
    outline: 3px solid var(--primary);
    outline-offset: 2px;
  }
  /* No script, no shuffling: the first place stands alone. */
  :global(html:not(.js)) .another {
    display: none;
  }
  /* "Another pick" fades the card body (opacity only, as in the app). */
  .pick.is-entering {
    animation: pick-in var(--dur-slow) var(--ease-out) both;
  }
  @keyframes pick-in {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .track {
      scroll-behavior: smooth;
    }
  }
</style>
