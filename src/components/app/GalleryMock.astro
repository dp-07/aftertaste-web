---
/**
 * The app's Gallery (SPEC v1.10), drawn with glyph tiles: the "On this day"
 * strip, a month section head (Prata month, mono count) and a mosaic of unequal
 * tiles with the Must-try stamp. Web deviation: the strip's "1 year ago" label
 * sits under the photo, not on a scrim over it (cream on the scrim is below AA).
 */
import Stamp from '../brand/Stamp.astro';
import Icon from '../ui/Icon.astro';
import Thumb from './Thumb.astro';

type Kind = 'mushroom' | 'sprout' | 'noodle' | 'cinnamon';
interface Props {
  label: string;
  onThisDay: Array<{ kind: Kind; when: string; dish: string }>;
  month: string;
  count: number;
  tiles: Array<{ kind: Kind; tall?: boolean; wide?: boolean; mustTry?: boolean }>;
}
const { label, onThisDay, month, count, tiles } = Astro.props;
---

<div class="gallery" role="group" aria-label={label}>
  <p class="t-label muted strip-title">
    <Icon name="calendar" size={16} />
    On this day
  </p>
  <ul class="strip">
    {onThisDay.map((e) => (
      <li>
        <Thumb kind={e.kind} class="strip-photo" />
        <span class="t-mono muted">{e.when}</span>
        <span class="visually-hidden">: {e.dish}</span>
      </li>
    ))}
  </ul>
  <p class="month">
    <span class="t-card-title">{month}</span>
    <span class="t-mono muted">{count} photos</span>
  </p>
  <div class="mosaic" aria-hidden="true">
    {tiles.map((t) => (
      <span class:list={['tile', { 'tile--tall': t.tall, 'tile--wide': t.wide, 'tile--stamped': t.mustTry }]}>
        <Thumb kind={t.kind} class="tile-photo" />
        {t.mustTry && <Stamp variant="mustTry" size="sm" class="tile-stamp" />}
      </span>
    ))}
  </div>
</div>

<style>
  .gallery {
    display: grid;
    gap: var(--s-12);
    max-inline-size: 28rem;
    padding: var(--s-16);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--elevation);
  }
  .strip-title {
    display: flex;
    align-items: center;
    gap: var(--s-8);
    margin: 0;
  }
  .strip-title :global(.icon) {
    color: var(--primary);
  }
  .strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .strip li {
    display: grid;
    gap: var(--s-4);
  }
  .strip :global(.strip-photo) {
    inline-size: 100%;
    aspect-ratio: 112 / 148;
  }
  .month {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-12);
    margin: var(--s-8) 0 0;
    padding-block-start: var(--s-12);
    border-block-start: 1px solid var(--line);
  }
  .mosaic {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: 4.5rem;
    grid-auto-flow: dense;
    gap: 4px;
  }
  .tile {
    position: relative;
  }
  .tile--tall {
    grid-row: span 2;
  }
  .tile--wide {
    grid-column: span 2;
  }
  .tile :global(.tile-photo) {
    position: absolute;
    inset: 0;
    border-radius: var(--r-sm);
  }
  /* Fixed glyph sizes: a percentage height does not resolve inside the tile's grid. */
  .tile :global(.tile-photo .food) {
    inline-size: 2.75rem;
    block-size: 2.75rem;
  }
  .tile--tall :global(.tile-photo .food) {
    inline-size: 3.75rem;
    block-size: 3.75rem;
  }
  /* The stamp takes the start corner; the glyph moves to the end so they don't collide. */
  .tile--stamped :global(.tile-photo) {
    justify-items: end;
    padding-inline-end: 12%;
  }
  .tile :global(.tile-stamp) {
    position: absolute;
    inset-block-end: var(--s-8);
    inset-inline-start: var(--s-8);
  }
</style>
