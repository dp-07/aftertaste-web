---
/**
 * A plain phone frame around an app screenshot. Pass a real screenshot
 * (portrait PNG/JPG, ideally 1080 × 2340) as `src`; Astro emits AVIF and WebP
 * at several widths with a PNG fallback, and sets width/height so nothing
 * shifts. `priority` is for the hero (eager, high fetch priority).
 * Replace the placeholders in src/assets/screenshots/ (README "Screenshots").
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  priority?: boolean;
  /** Rendered width hint for `sizes`. */
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  priority = false,
  sizes = '(width >= 64rem) 22rem, (width >= 40rem) 18rem, 72vw',
  class: className,
} = Astro.props;
---

<figure class:list={['phone', className]}>
  <div class="bezel">
    <div class="screen">
      <Picture
        src={src}
        alt={alt}
        formats={['avif', 'webp']}
        widths={[280, 400, 560, 720, 1080]}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : 'auto'}
      />
    </div>
  </div>
  <slot />
</figure>

<style>
  .phone {
    position: relative;
    inline-size: 100%;
    max-inline-size: 22rem;
    margin: 0;
    container-type: inline-size;
  }

  /* The device stays ink in both themes; dark mode adds a hairline so it separates from the page. */
  .bezel {
    padding: 3.2cqi;
    border-radius: 14cqi;
    background: #1f1b16;
    box-shadow:
      0 0 0 1px light-dark(transparent, #4d453b),
      0 2px 4px light-dark(rgb(31 27 22 / 0.12), transparent),
      0 30px 60px -28px light-dark(rgb(31 27 22 / 0.45), rgb(0 0 0 / 0.6));
  }

  .screen {
    overflow: hidden;
    border-radius: 11cqi;
    background: var(--bg);
    aspect-ratio: 1080 / 2340;
  }

  .screen :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
</style>
