---
/**
 * A plain phone frame around an app screenshot. Pass a real screenshot
 * (portrait PNG/JPG, ideally 1080 × 2340) as `src`; Astro emits AVIF and WebP
 * at several widths with a PNG fallback, and sets width/height so nothing
 * shifts. `priority` is for the hero (eager, high fetch priority).
 * Replace the placeholders in src/assets/screenshots/ (README "Screenshots").
 *
 * `srcDark` is the same screen in the app's dark theme. The frame then follows
 * the site theme, so the screenshot never stays light while the page goes dark:
 * - System theme: one <picture> whose dark <source> has a prefers-color-scheme
 *   media query, so only the matching image is fetched (and gets the priority).
 * - Manual override against the system (data-theme set by the theme toggle): a
 *   lazy second <picture> of the other theme is swapped in with CSS; it is only
 *   downloaded if it is ever shown.
 */
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  /** The same screenshot in the dark theme. */
  srcDark?: ImageMetadata;
  alt: string;
  priority?: boolean;
  /** Rendered width hint for `sizes`. */
  sizes?: string;
  class?: string;
}

const {
  src,
  srcDark,
  alt,
  priority = false,
  sizes = '(width >= 64rem) 22rem, (width >= 40rem) 18rem, 72vw',
  class: className,
} = Astro.props;

const WIDTHS = [280, 400, 560, 720, 1080];
const FORMATS = ['avif', 'webp', 'png'] as const;

/** srcset strings per format, like <Picture> builds them. */
async function srcsets(image: ImageMetadata) {
  const out = {} as Record<(typeof FORMATS)[number], string>;
  for (const format of FORMATS) {
    const made = await Promise.all(WIDTHS.map((width) => getImage({ src: image, width, format })));
    out[format] = made.map((m) => `${m.src} ${m.attributes.width}w`).join(', ');
  }
  return out;
}
const light = await srcsets(src);
const dark = srcDark ? await srcsets(srcDark) : null;
const fallback = await getImage({ src, width: 720, format: 'png' });
const img = {
  width: fallback.attributes.width,
  height: fallback.attributes.height,
  loading: priority ? 'eager' : 'lazy',
  fetchpriority: priority ? 'high' : 'auto',
} as const;
---

<figure class:list={['phone', className]}>
  <div class="bezel">
    <div class="screen">
      {srcDark && dark ? (
        <>
          <picture class="shot shot-main">
            {FORMATS.map((f) => (
              <source media="(prefers-color-scheme: dark)" type={`image/${f}`} srcset={dark[f]} sizes={sizes} />
            ))}
            {FORMATS.slice(0, 2).map((f) => (
              <source type={`image/${f}`} srcset={light[f]} sizes={sizes} />
            ))}
            <img
              src={fallback.src}
              srcset={light.png}
              sizes={sizes}
              alt={alt}
              width={img.width}
              height={img.height}
              loading={img.loading}
              decoding="async"
              fetchpriority={img.fetchpriority}
            />
          </picture>
          <div class="shot shot-alt shot-alt-dark" aria-hidden="true">
            <Picture
              src={srcDark}
              alt=""
              formats={['avif', 'webp']}
              widths={WIDTHS}
              sizes={sizes}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="shot shot-alt shot-alt-light" aria-hidden="true">
            <Picture
              src={src}
              alt=""
              formats={['avif', 'webp']}
              widths={WIDTHS}
              sizes={sizes}
              loading="lazy"
              decoding="async"
            />
          </div>
        </>
      ) : (
        <Picture
          src={src}
          alt={alt}
          formats={['avif', 'webp']}
          widths={WIDTHS}
          sizes={sizes}
          loading={img.loading}
          decoding="async"
          fetchpriority={img.fetchpriority}
        />
      )}
    </div>
  </div>
  <slot />
</figure>

<style>
  .phone {
    position: relative;
    inline-size: 100%;
    max-inline-size: 22rem;
    margin: 0;
    container-type: inline-size;
  }

  /* The device stays ink in both themes; dark mode adds a hairline so it separates from the page. */
  .bezel {
    padding: 3.2cqi;
    border-radius: 14cqi;
    background: #1f1b16;
    box-shadow:
      0 0 0 1px light-dark(transparent, #4d453b),
      0 2px 4px light-dark(rgb(31 27 22 / 0.12), transparent),
      0 30px 60px -28px light-dark(rgb(31 27 22 / 0.45), rgb(0 0 0 / 0.6));
  }

  .screen {
    overflow: hidden;
    border-radius: 11cqi;
    background: var(--bg);
    aspect-ratio: 1080 / 2340;
  }

  .screen :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .shot {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  /* The other-theme copies only show when the toggle overrides the system theme. */
  .shot-alt {
    display: none;
  }

  @media (prefers-color-scheme: light) {
    :global(:root[data-theme='dark']) .shot-main {
      display: none;
    }
    :global(:root[data-theme='dark']) .shot-alt-dark {
      display: block;
    }
  }

  @media (prefers-color-scheme: dark) {
    :global(:root[data-theme='light']) .shot-main {
      display: none;
    }
    :global(:root[data-theme='light']) .shot-alt-light {
      display: block;
    }
  }
</style>
