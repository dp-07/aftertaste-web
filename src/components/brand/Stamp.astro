---
/**
 * Ink stamps from the app:
 *   placeStrong  RECOMMENDED · WOULD RETURN (VerdictStamp; stacks at `sm`)
 *   mustTry      MUST-TRY
 *   tried        TRIED (herb ink; a status mark, not a verdict)
 *   logged       LOGGED + date (the receipt stamp, −12°, 0.88 opacity)
 *
 * Construction per SPEC: outer rule, inner rule, uppercase tracked DM Sans
 * Medium on an opaque paper fill, rotated −4°. Measured in em from the
 * app's `md` size (13 px type), so `font-size` scales it.
 *
 * `press` hides the stamp until the landing script adds `.is-pressed` as it
 * scrolls into view, then plays the brand stampPress (700 ms: 1.7 → 0.94 → 1,
 * ink ripple at 420 ms). Without JS or with reduced motion it simply shows.
 */
interface Props {
  variant: 'placeStrong' | 'mustTry' | 'tried' | 'logged';
  size?: 'sm' | 'md' | 'lg';
  /** LOGGED stamp date, e.g. "12 Nov 2026". */
  date?: string;
  press?: boolean;
  class?: string;
}

const { variant, size = 'md', date = '', press = false, class: className } = Astro.props;

const copy = {
  placeStrong: { lines: ['RECOMMENDED', 'WOULD RETURN'], label: 'Recommended, would return' },
  mustTry: { lines: ['MUST-TRY'], label: 'Must-try' },
  tried: { lines: ['TRIED'], label: 'Tried' },
  logged: { lines: ['LOGGED'], label: `Logged ${date}`.trim() },
}[variant];
const lines = variant === 'placeStrong' && size !== 'sm' ? [copy.lines.join(' · ')] : copy.lines;
---

<span
  class:list={['stamp', `stamp--${variant}`, `stamp--${size}`, className]}
  role="img"
  aria-label={copy.label}
  data-press={press ? '' : undefined}
>
  <span class="stamp-inner" aria-hidden="true">
    {lines.map((l) => (
      <span class="stamp-word">{l}</span>
    ))}
    {variant === 'logged' && date && <span class="stamp-date">{date.toUpperCase()}</span>}
  </span>
</span>

<style>
  .stamp {
    --ink: var(--primary);
    --rot: -4deg;
    --outer: calc(2em / 13);
    --radius: calc(8em / 13);
    position: relative;
    display: inline-block;
    padding: var(--outer);
    border: var(--outer) solid var(--ink);
    border-radius: var(--radius);
    background: var(--stamp-paper);
    color: var(--ink);
    font-family: var(--font-ui);
    font-weight: 500;
    line-height: calc(17 / 13);
    letter-spacing: var(--tracking-stamp);
    white-space: nowrap;
    transform: rotate(var(--rot));
    pointer-events: none;
  }

  .stamp--sm {
    font-size: 0.625rem;
  }
  .stamp--md {
    font-size: 0.8125rem;
  }
  .stamp--lg {
    font-size: clamp(0.9375rem, 0.8rem + 0.6vw, 1.25rem);
  }

  .stamp--tried {
    --ink: var(--herb);
  }

  .stamp-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(2em / 13);
    padding: calc(5em / 13) calc(12em / 13);
    border: 1px solid var(--ink);
    border-radius: calc(var(--radius) - var(--outer) - 1px);
  }

  .stamp-word {
    margin-inline-end: calc(-1 * var(--tracking-stamp));
  }

  /* The receipt's LOGGED stamp: ink on paper, −12°, 0.88 opacity. */
  .stamp--logged {
    --ink: var(--stamp-logged);
    --rot: -12deg;
    --outer: calc(2.5em / 14);
    --radius: calc(8em / 14);
    font-size: 0.875rem;
    background: transparent;
    opacity: 0.88;
    letter-spacing: calc(2.5em / 14);
  }

  .stamp--logged .stamp-inner {
    gap: 0;
    padding: calc(4em / 14) calc(10em / 14);
  }

  .stamp-date {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: calc(10em / 14);
    line-height: 1.3;
    letter-spacing: 0.05em;
  }

  /* Ink ripple (brand stampPress.inkRipple). */
  .stamp::after {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--outer));
    border: var(--outer) solid var(--ink);
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .stamp[data-press]:not(.is-pressed) {
      opacity: 0;
    }

    .stamp.is-pressed {
      animation: stamp-press 700ms linear both;
    }

    .stamp--logged.is-pressed {
      animation-name: stamp-press-logged;
    }

    .stamp.is-pressed::after {
      animation: stamp-ripple 500ms var(--ease-out) 420ms both;
    }
  }

  @keyframes stamp-press {
    0% {
      opacity: 0;
      transform: rotate(calc(var(--rot) + 6deg)) scale(1.7);
      animation-timing-function: var(--ease-standard);
    }
    60% {
      opacity: 1;
      transform: rotate(var(--rot)) scale(0.94);
      /* Ink settles: the paper is briefly flooded, then dries back. */
      background-color: color-mix(in srgb, var(--ink) 16%, var(--stamp-paper));
      animation-timing-function: var(--ease-out);
    }
    100% {
      opacity: 1;
      transform: rotate(var(--rot)) scale(1);
    }
  }

  @keyframes stamp-press-logged {
    0% {
      opacity: 0;
      transform: rotate(calc(var(--rot) + 6deg)) scale(1.7);
      animation-timing-function: var(--ease-standard);
    }
    60% {
      opacity: 0.88;
      transform: rotate(var(--rot)) scale(0.94);
      animation-timing-function: var(--ease-out);
    }
    100% {
      opacity: 0.88;
      transform: rotate(var(--rot)) scale(1);
    }
  }

  @keyframes stamp-ripple {
    from {
      opacity: 0.35;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(1.3);
    }
  }
</style>
