---
import Wordmark from './brand/Wordmark.astro';
import ThemeToggle from './ui/ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const links = [
  { href: '/#how-it-works', label: 'How it works' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/support', label: 'Support' },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="home">
      <Wordmark simple />
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href} class="nav-link" aria-current={path === l.href ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    container-type: inline-size;
    padding-block: var(--s-16);
    view-transition-name: site-header;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--s-16);
  }

  .home {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch);
    margin-inline-end: auto;
    font-size: 1.5rem;
    color: var(--text);
    text-decoration: none;
    border-radius: var(--r-sm);
  }

  nav ul {
    display: flex;
    gap: var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch);
    padding-inline: var(--s-12);
    border-radius: var(--r-pill);
    color: var(--muted);
    font-size: var(--fs-body-sm);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--dur-base) var(--ease-out);
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--text);
  }

  .nav-link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--primary);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
  }

  /* Narrow headers keep the wordmark and the theme toggle; the footer has the links. */
  @container (width < 40rem) {
    nav {
      display: none;
    }
  }
</style>
