---
import Wordmark from './brand/Wordmark.astro';
import ThemeToggle from './ui/ThemeToggle.astro';
import { site } from '../config/site';

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const links = [
  { href: '/#how-it-works', label: 'How it works' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/support', label: 'Support' },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="home">
      <Wordmark simple />
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href} class="nav-link" aria-current={path === l.href ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a href={site.betaAnchor} class="cta">
      Join the beta
    </a>
    <ThemeToggle />
  </div>
</header>

<style>
  /* Sticky and opaque: page content scrolls under it. Below the skip link (100).
     A strip of cream paper (surface) with a double ledger rule, like the app's cards. */
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    container-type: inline-size;
    display: flex;
    align-items: center;
    block-size: var(--header-h);
    border-block-end: 3px double var(--line-strong);
    background: var(--surface);
    view-transition-name: site-header;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--s-16);
  }

  .home {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch);
    margin-inline-end: auto;
    font-size: 2rem; /* the simple wordmark tops out at 32 px */
    color: var(--text);
    text-decoration: none;
    border-radius: var(--r-sm);
  }

  nav ul {
    display: flex;
    gap: var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch);
    padding-inline: var(--s-12);
    border-radius: var(--r-pill);
    color: var(--muted);
    font-size: var(--fs-body-sm);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--dur-base) var(--ease-out);
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    background: var(--primary-soft);
    color: var(--text);
  }

  /* The current page also carries a paprika dot. */
  .nav-link[aria-current='page']::before {
    content: '';
    inline-size: 6px;
    block-size: 6px;
    margin-inline-end: var(--s-8);
    border-radius: 50%;
    background: var(--primary);
  }

  .cta {
    display: none;
    align-items: center;
    min-block-size: var(--touch);
    padding-inline: var(--s-20);
    border-radius: var(--r-pill);
    background: var(--btn-bg);
    color: var(--on-primary);
    font-size: var(--fs-body-sm);
    font-weight: 500;
    text-decoration: none;
    transition:
      transform var(--dur-fast) var(--ease-out),
      background-color var(--dur-base) var(--ease-out);
  }

  .cta:hover {
    background: var(--btn-bg-hover);
  }

  .cta:active {
    transform: scale(var(--press-scale));
  }

  @media (prefers-reduced-motion: reduce) {
    .cta:active {
      transform: none;
      opacity: 0.7;
    }
  }

  /* The button needs room: wide headers only. */
  @container (width >= 52rem) {
    .cta {
      display: inline-flex;
    }
  }

  /* Narrow headers keep the wordmark and the theme toggle; the footer has the links. */
  @container (width < 40rem) {
    nav {
      display: none;
    }
  }
</style>
