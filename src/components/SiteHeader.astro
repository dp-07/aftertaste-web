---
/**
 * Minimal sticky header (web revamp 2026-11-27): wordmark, a Features menu,
 * Privacy, the beta call to action and the theme toggle. Wide headers show the
 * Features dropdown inline; narrow ones fold everything into one Menu panel.
 * Both are native <details>, so they open and close without JavaScript;
 * the inline theme script (src/scripts/theme.js) adds one-open-at-a-time,
 * Escape, outside click and close-on-navigate, so pages that ship no script
 * files (legal, support, 404) still get them.
 */
import Wordmark from './brand/Wordmark.astro';
import ThemeToggle from './ui/ThemeToggle.astro';
import Icon from './ui/Icon.astro';
import { site } from '../config/site';
import { features } from '../config/features';

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const current = (href: string) => (path === href ? 'page' : undefined);
const onFeature = features.some((f) => f.href === path);
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="home" aria-current={current('/')}>
      <Wordmark simple />
    </a>

    <nav class="wide" aria-label="Main">
      <ul>
        <li>
          <details class="menu" data-menu>
            <summary class:list={['nav-link', { on: onFeature }]}>
              Features <Icon name="chevron-down" size={16} class="chev" />
            </summary>
            <ul class="panel">
              {features.map((f) => (
                <li>
                  <a href={f.href} class="panel-link" aria-current={current(f.href)}>
                    <span class="panel-label">{f.label}</span>
                    <span class="panel-line">{f.line}</span>
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </li>
        <li>
          <a href="/privacy" class="nav-link" aria-current={current('/privacy')}>
            Privacy
          </a>
        </li>
      </ul>
    </nav>

    <a href={site.betaAnchor} class="cta">
      Join the beta
    </a>
    <div class="toggle-wide">
      <ThemeToggle />
    </div>

    <details class="menu narrow" data-menu>
      <summary class="nav-link menu-btn">
        <Icon name="menu" size={20} class="i-open" />
        <Icon name="x" size={20} class="i-close" />
        Menu
      </summary>
      <nav class="sheet" aria-label="Main menu">
        <p class="t-label sheet-head">Features</p>
        <ul>
          {features.map((f) => (
            <li>
              <a href={f.href} class="sheet-link" aria-current={current(f.href)}>
                {f.label}
              </a>
            </li>
          ))}
        </ul>
        <ul class="sheet-more">
          <li>
            <a href="/privacy" class="sheet-link small" aria-current={current('/privacy')}>
              Privacy
            </a>
          </li>
          <li>
            <a href="/support" class="sheet-link small" aria-current={current('/support')}>
              Support
            </a>
          </li>
        </ul>
        <a href={site.betaAnchor} class="sheet-cta">
          Join the beta
        </a>
        <ThemeToggle />
      </nav>
    </details>
  </div>
</header>

<style>
  /* Sticky and opaque: page content scrolls under it. Below the skip link (100). */
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    container-type: inline-size;
    display: flex;
    align-items: center;
    block-size: var(--header-h);
    /* A strip of cream paper with a double ledger rule, like the app's cards (decision 2026-11-17). */
    border-block-end: 3px double var(--line-strong);
    background: var(--surface);
    view-transition-name: site-header;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--s-8);
  }

  .home {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch);
    margin-inline-end: auto;
    font-size: 1.75rem;
    color: var(--text);
    text-decoration: none;
    border-radius: var(--r-sm);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wide > ul {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-4);
    min-block-size: var(--touch);
    padding-inline: var(--s-12);
    border-radius: var(--r-pill);
    color: var(--muted);
    font-size: var(--fs-body-sm);
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition:
      color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out);
  }

  summary {
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .nav-link:hover,
  .nav-link[aria-current='page'],
  .nav-link.on,
  details[open] > .nav-link {
    background: var(--primary-soft);
    color: var(--text);
  }

  .menu {
    position: relative;
  }

  .menu :global(.chev) {
    transition: transform var(--dur-base) var(--ease-out);
  }

  details[open] :global(.chev) {
    transform: rotate(180deg);
  }

  /* Features dropdown: a raised card of four rows. */
  .panel {
    position: absolute;
    inset-block-start: calc(100% + var(--s-8));
    inset-inline-start: calc(-1 * var(--s-8));
    display: grid;
    gap: 2px;
    inline-size: 20rem;
    padding: var(--s-8);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--raised);
    box-shadow: var(--elevation);
  }

  .panel-link {
    display: grid;
    gap: 2px;
    padding: var(--s-12);
    border-radius: var(--r-md);
    color: var(--text);
    text-decoration: none;
  }

  .panel-link:hover,
  .panel-link[aria-current='page'] {
    background: var(--primary-soft);
  }

  .panel-label {
    font-weight: 600;
  }

  .panel-line {
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
    color: var(--muted);
  }

  .cta,
  .sheet-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: var(--touch);
    padding-inline: var(--s-20);
    border-radius: var(--r-pill);
    background: var(--btn-bg);
    color: var(--on-primary);
    font-size: var(--fs-body-sm);
    font-weight: 500;
    text-decoration: none;
    transition:
      transform var(--dur-fast) var(--ease-out),
      background-color var(--dur-base) var(--ease-out);
  }

  .cta:hover,
  .sheet-cta:hover {
    background: var(--btn-bg-hover);
  }

  .cta:active,
  .sheet-cta:active {
    transform: scale(var(--press-scale));
  }

  /* Narrow: one Menu button and a full-width sheet under the header. */
  .menu-btn {
    color: var(--text);
  }

  .menu-btn :global(.i-close),
  details[open] > .menu-btn :global(.i-open) {
    display: none;
  }

  details[open] > .menu-btn :global(.i-close) {
    display: inline-block;
  }

  .narrow {
    position: static;
  }

  .sheet {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    display: grid;
    gap: var(--s-16);
    padding: var(--s-20) var(--gutter) var(--s-24);
    border-block-end: 1px solid var(--line);
    background: var(--surface);
    box-shadow: var(--elevation);
  }

  .sheet-head {
    margin: 0;
    color: var(--muted);
  }

  .sheet ul {
    display: grid;
  }

  .sheet-link {
    display: flex;
    align-items: center;
    min-block-size: var(--touch);
    font-family: var(--font-display);
    font-size: var(--fs-card-title);
    color: var(--text);
    text-decoration: none;
  }

  .sheet-link.small {
    font-family: var(--font-ui);
    font-size: var(--fs-body);
    color: var(--muted);
  }

  .sheet-link[aria-current='page'] {
    color: var(--primary-ink);
  }

  .sheet :global(.theme-toggle) {
    justify-self: start;
  }

  .sheet-more {
    padding-block-start: var(--s-8);
    border-block-start: 1px solid var(--line);
  }

  .cta,
  .toggle-wide,
  .wide {
    display: none;
  }

  @container (width >= 52rem) {
    .wide,
    .toggle-wide {
      display: block;
    }
    .cta {
      display: inline-flex;
    }
    .narrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta:active,
    .sheet-cta:active {
      transform: none;
      opacity: 0.7;
    }
  }
</style>
