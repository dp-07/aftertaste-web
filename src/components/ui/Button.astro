---
/**
 * The app's Button (SPEC: pill, 52 high, DM Sans Medium 16, press scale 0.97;
 * reduced motion dips opacity instead). Renders an <a> when `href` is given.
 */
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';

type Variant = 'primary' | 'secondary' | 'ghost';

interface Props extends Omit<HTMLAttributes<'button'>, 'class'> {
  href?: string;
  variant?: Variant;
  icon?: string;
  iconEnd?: boolean;
  class?: string;
}

const { href, variant = 'primary', icon, iconEnd = false, class: className, type = 'button', ...rest } = Astro.props;
const classes = ['btn', `btn--${variant}`, className];
---

{href ? (
  <a href={href} class:list={classes}>
    {icon && !iconEnd && <Icon name={icon} size={18} />}
    <span class="btn-label">
      <slot />
    </span>
    {icon && iconEnd && <Icon name={icon} size={18} />}
  </a>
) : (
  <button type={type} class:list={classes} {...rest}>
    {icon && !iconEnd && <Icon name={icon} size={18} />}
    <span class="btn-label">
      <slot />
    </span>
    {icon && iconEnd && <Icon name={icon} size={18} />}
  </button>
)}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-8);
    min-block-size: var(--control-h);
    padding-inline: var(--s-24);
    border: 1px solid transparent;
    border-radius: var(--r-pill);
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: var(--fs-button);
    line-height: 1.25;
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform var(--dur-fast) var(--ease-out),
      background-color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  .btn:active {
    transform: scale(var(--press-scale));
  }

  @media (prefers-reduced-motion: reduce) {
    .btn:active {
      transform: none;
      opacity: 0.7;
    }
  }

  .btn--primary {
    background: var(--primary);
    color: var(--on-primary);
  }

  .btn--primary:hover {
    background: var(--primary-pressed);
  }

  .btn--secondary {
    background: var(--surface);
    border-color: var(--line-strong);
    color: var(--text);
  }

  .btn--secondary:hover {
    border-color: var(--text);
  }

  .btn--ghost {
    background: transparent;
    color: var(--text);
    padding-inline: var(--s-16);
  }

  .btn--ghost:hover {
    background: var(--primary-soft);
  }

  .btn :global(.icon) {
    flex: none;
  }
</style>
