---
/**
 * A text link whose ink underline draws in on hover and focus (base.css
 * `.ink-link`). External links open in the same tab, like every other link.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;
const { class: className, ...rest } = Astro.props;
---

<a class:list={['ink-link', className]} {...rest}>
  <slot />
</a>
