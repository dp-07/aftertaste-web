---
/**
 * A receipt printer (web revamp 2026-11-27): the slot, and the visit receipt
 * feeding out of it in the brand's receiptPrint steps (−1, −0.74, −0.46, −0.16,
 * 0 of its height; 360 ms moves, 200 ms pauses) once it is a third in view. Then
 * the LOGGED stamp lands (brand stampPress) and the paper takes a small thud.
 * The paper waits out of sight under html.js (set before first paint by the
 * theme script, so nothing flashes); src/scripts/landing.ts adds .is-printing.
 * Without JavaScript, or with reduced motion, the receipt is simply printed and
 * stamped. Transform and opacity only, inside a clipped box: nothing shifts.
 */
import Receipt, { type ReceiptDish } from '../brand/Receipt.astro';

interface Props {
  placeName: string;
  area?: string;
  date: string;
  dishes: ReceiptDish[];
  notes?: string;
  total?: string;
  overall: number;
}
const props = Astro.props;
---

<div class="printer" data-printer>
  <div class="slot" aria-hidden="true"></div>
  <div class="feed">
    <Receipt {...props} class="printed" />
  </div>
</div>

<style>
  .printer {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    inline-size: min(100%, 400px);
  }

  .slot {
    position: relative;
    z-index: 1;
    inline-size: 100%;
    block-size: 18px;
    border-radius: var(--r-pill);
    background: light-dark(#1f1b16, #0d0b09);
    box-shadow:
      inset 0 -5px 0 light-dark(#3a332b, #29241e),
      0 0 0 1px light-dark(transparent, #4d453b);
  }

  /* One shrinkable column: an auto column would grow to the receipt's 330 px. */
  .feed {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    inline-size: 100%;
    margin-block-start: -9px;
    padding: 0 24px 40px;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .printer:not(.is-printing) .feed :global(.printed) {
      transform: translateY(-100%);
    }

    :global(html.js) .printer:not(.is-printing) .feed :global(.rc-stamp) {
      opacity: 0;
    }

    /* Feed, then the thud as the stamp hits (stamp lands at 2300 + 60% of 700 ms). */
    .printer.is-printing .feed :global(.printed) {
      animation:
        feed-steps 2240ms linear both,
        thud 280ms var(--ease-out) 2720ms;
    }

    .printer.is-printing .feed :global(.rc-stamp) {
      animation: logged-land 700ms linear 2300ms both;
    }
  }

  @keyframes feed-steps {
    0% {
      transform: translateY(-100%);
      animation-timing-function: var(--ease-standard);
    }
    16% {
      transform: translateY(-74%);
    }
    25% {
      transform: translateY(-74%);
      animation-timing-function: var(--ease-standard);
    }
    41% {
      transform: translateY(-46%);
    }
    50% {
      transform: translateY(-46%);
      animation-timing-function: var(--ease-standard);
    }
    66% {
      transform: translateY(-16%);
    }
    75% {
      transform: translateY(-16%);
      animation-timing-function: var(--ease-standard);
    }
    91%,
    100% {
      transform: none;
    }
  }

  /* The paper gives under the stamp: 3 px down and back. */
  @keyframes thud {
    0%,
    100% {
      transform: none;
    }
    35% {
      transform: translateY(3px) scale(0.995);
    }
  }

  /* brand stampPress, at the receipt stamp's −8° and 0.88 opacity. */
  @keyframes logged-land {
    0% {
      opacity: 0;
      transform: rotate(-2deg) scale(1.7);
      animation-timing-function: var(--ease-standard);
    }
    60% {
      opacity: 0.88;
      transform: rotate(-8deg) scale(0.94);
      animation-timing-function: var(--ease-out);
    }
    100% {
      opacity: 0.88;
      transform: rotate(-8deg) scale(1);
    }
  }
</style>
