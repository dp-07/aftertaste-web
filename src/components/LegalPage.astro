---
/**
 * A legal document from the `legal` collection: title, last updated (the
 * source file's last commit in the app repo), a table of contents from the
 * H2s, the text in editorial prose, and print styles. Unresolved [TODO: …]
 * markers are highlighted by src/lib/remark-legal.mjs and flagged here.
 */
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { mailto, site } from '../config/site';

interface Props {
  id: 'privacy' | 'terms';
  title: string;
  description: string;
}

const { id, title, description } = Astro.props;
const entry = await getEntry('legal', id);
if (!entry) throw new Error(`[legal] src/content/legal/${id}.md is missing: run npm run sync:legal`);
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
// Count what readers see: the draft-notes comment is stripped from the page.
const visibleBody = (entry.body ?? '').replace(/<!--[\s\S]*?-->/g, '');
const todoCount = (visibleBody.match(/\[TODO:/g) ?? []).length;
// Every build says so (the remark plugin's per-TODO warnings only run when the markdown changes).
if (todoCount > 0) console.warn(`[legal-todo] ${id}.md: ${todoCount} unresolved [TODO: …] marker(s) shown on /${id}`);
const updated = new Date(`${entry.data.sourceUpdated}T00:00:00Z`).toLocaleDateString('en-IN', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const other =
  id === 'privacy' ? { href: '/terms', label: 'Terms of use' } : { href: '/privacy', label: 'Privacy policy' };
---

<BaseLayout title={title} description={description} og="legal">
  <article class="wrap legal">
    <header class="head">
      <p class="t-label kicker">Aftertaste · Legal</p>
      <h1 class="t-display">{title}</h1>
      <p class="t-mono muted meta">
        Last updated <time datetime={entry.data.sourceUpdated}>{updated}</time> <span aria-hidden="true">·</span>{' '}
        <span>Version {entry.data.sourceCommit.slice(0, 7)}</span>
      </p>
      {todoCount > 0 && (
        <p class="draft" role="note">
          <strong>Draft.</strong> {todoCount} highlighted {todoCount === 1 ? 'note is' : 'notes are'} still being
          finalised. Questions? <a href={mailto(`Question about the ${title.toLowerCase()}`)}>{site.contactEmail}</a>
        </p>
      )}
    </header>

    <div class="layout">
      <nav class="toc" aria-labelledby="toc-title">
        <p id="toc-title" class="t-label muted">
          Contents
        </p>
        <ol>
          {toc.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </nav>
      <div class="prose">
        <Content />
        <p class="also">
          See also: <a href={other.href}>{other.label}</a>
        </p>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .legal {
    padding-block-start: clamp(2rem, 1rem + 4vw, 4.5rem);
  }

  .head {
    display: grid;
    justify-items: start;
    gap: var(--s-16);
    padding-block-end: var(--space-block);
    border-block-end: 1px solid var(--line-strong);
  }

  .kicker {
    color: var(--primary-ink);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-8);
  }

  .draft {
    max-inline-size: 40rem;
    padding: var(--s-12) var(--s-16);
    border: 1px dashed var(--primary);
    border-radius: var(--r-md);
    background: var(--primary-soft);
    font-size: var(--fs-body-sm);
  }

  .draft a {
    color: inherit;
    overflow-wrap: anywhere;
  }

  .layout {
    display: grid;
    gap: var(--space-block);
    padding-block-start: var(--space-block);
  }

  .toc ol {
    display: grid;
    gap: 2px;
    margin: var(--s-12) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: toc;
  }

  .toc a {
    display: block;
    padding-block: 6px;
    color: var(--muted);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--primary-ink);
  }

  @media (width >= 64rem) {
    .layout {
      grid-template-columns: 15rem minmax(0, 44rem);
      column-gap: clamp(3rem, 6vw, 7rem);
    }

    .toc {
      position: sticky;
      inset-block-start: var(--s-24);
      align-self: start;
      max-block-size: calc(100vh - 3rem);
      overflow-y: auto;
    }
  }

  /* ── Prose ── */
  .prose {
    max-inline-size: 44rem;
    font-size: var(--fs-body);
    line-height: 1.65;
  }

  .prose :global(h2) {
    margin-block: var(--s-40) var(--s-12);
    font-size: var(--fs-title);
    line-height: var(--lh-title);
    scroll-margin-block-start: var(--s-24);
  }

  .prose :global(h2:first-child) {
    margin-block-start: 0;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-block-end: var(--s-16);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-inline-start: 1.25rem;
  }

  .prose :global(li) {
    margin-block-end: var(--s-8);
  }

  .prose :global(li::marker) {
    color: var(--primary);
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  .prose :global(a) {
    overflow-wrap: anywhere;
  }

  .prose :global(.legal-todo) {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--primary-soft);
    color: var(--text);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    outline: 1px dashed var(--primary);
    outline-offset: -1px;
  }

  .prose :global(.legal-todo-tag) {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.75em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--todo-ink);
  }

  .also {
    margin-block-start: var(--s-40);
    padding-block-start: var(--s-16);
    border-block-start: 1px solid var(--line);
    color: var(--muted);
  }

  /* ── Print: the document, in ink, with link targets written out ── */
  @media print {
    .toc,
    .draft a {
      display: none;
    }

    .legal {
      padding: 0;
    }

    .layout {
      display: block;
      padding-block-start: var(--s-16);
    }

    .prose {
      max-inline-size: none;
      font-size: 11pt;
      line-height: 1.5;
    }

    .prose :global(h2) {
      break-after: avoid;
      font-size: 15pt;
    }

    .prose :global(p),
    .prose :global(li) {
      orphans: 3;
      widows: 3;
    }

    .prose :global(a[href^='http'])::after,
    .prose :global(a[href^='mailto'])::after {
      content: ' (' attr(href) ')';
      font-size: 0.85em;
      color: #5e5548;
    }
  }
</style>
